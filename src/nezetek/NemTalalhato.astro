---
import Base from '../layouts/Base.astro';
import Ikon from '../components/Ikon.astro';
import { ut, type Nyelv } from '../i18n/utak';
import { alap, oldal } from '../lib/tartalom';
import { inline } from '../lib/szoveg';

interface Props {
  lang: Nyelv;
}
const { lang } = Astro.props;
const kulcs = 'nemtalalhato';
const a = await alap(lang);
const { felulet: f, tok } = a;
const o = await oldal(lang, kulcs);
const linkek = [{ szoveg: f.morzsa.fooldal, href: ut('fooldal', lang) }, ...f.menu.pontok.map((p) => ({ szoveg: p.szoveg, href: ut(p.oldal, lang) }))];
---

<Base lang={lang} kulcs={kulcs} title={o.seo.title} description={o.seo.description} noindex a={a}>
  <section class="sotet min-h-[70vh]" aria-labelledby="oldal-cim">
    <div class="tarolo py-20 sm:py-28">
      {o.hero.cimke && <p class="cimke" set:html={inline(o.hero.cimke, tok)} />}
      <h1 id="oldal-cim" class="h1 mt-6 max-w-3xl" set:html={inline(o.hero.cim, tok)} />
      {o.hero.alcim && <p class="bevezeto mt-6" set:html={inline(o.hero.alcim, tok)} />}
      <ul class="mt-10 grid max-w-3xl gap-x-10 sm:grid-cols-2" role="list">
        {
          linkek.map((l) => (
            <li class="border-b border-tinta-vonal">
              <a href={l.href} class="flex min-h-14 items-center justify-between gap-4 text-lg hover:text-bronz-vilagos">
                {l.szoveg}
                <Ikon nev="nyil" meret={18} class="text-bronz" />
              </a>
            </li>
          ))
        }
      </ul>
      <a href={`${ut('fooldal', lang)}#ajanlatkeres`} class="gomb gomb-bronz mt-12">{f.gombok.ajanlat}</a>
    </div>
  </section>
</Base>
