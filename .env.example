# Másold le .env néven, és töltsd ki. Élesben a tárhely (Netlify) felületén add meg ezeket.

# A végleges domain, perjel nélkül. A canonical URL-ek, a sitemap és az OG-képek ebből készülnek.
SITE_URL=https://www.example.hu

# Az AImpress CRM webhookja – ide érkezik minden űrlap (JSON POST).
CRM_WEBHOOK_URL=
# Nem kötelező: ha megadod, minden kérés X-Aura-Signature: sha256=<HMAC> fejlécet kap.
CRM_WEBHOOK_SECRET=

# Cookie nélküli látogatottságmérés (Plausible). Ha üres, nincs mérőkód az oldalon.
PUBLIC_PLAUSIBLE_DOMAIN=
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# netlify (alapértelmezés) vagy node (saját szerver / helyi éles teszt)
# DEPLOY_TARGET=netlify

# 1 = a robots.txt mindent tilt (pl. teszt-domainen)
# ROBOTS_NOINDEX=
